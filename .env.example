# Coin Private: environment variables
# Copy this file to `.env` for local development:  cp .env.example .env

# --- Database (required) ---------------------------------------------------
# Persistent PostgreSQL connection string from Prisma Postgres, Neon, Supabase,
# or another supported PostgreSQL host.
DATABASE_URL=postgresql://user:password@host:5432/coin_private?sslmode=require

# --- Sessions (required in production) -------------------------------------
# HMAC secret for per-tab session tokens. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# The initial Coin Private setup is created automatically on an empty database.
# Set this to false only when initialization is handled separately.
# ALLOW_DEMO_SEED=false

# Development test helper. Never enable this in a public production project.
# EXPOSE_DEMO_RESET_CODE=true

# --- Price provider (optional: overrides Management settings) --------------
# coingecko (live) | simulated | custom
#PRICE_PROVIDER=coingecko
#PRICE_PROVIDER_URL=
#PRICE_REFRESH_MS=5000
