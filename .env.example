# Coin Private: environment variables
# Copy this file to `.env` for local development:  cp .env.example .env

# --- Database (required) ---------------------------------------------------
# Local / demo: SQLite file, resolved relative to prisma/schema.prisma.
# The app auto-creates the schema and seeds demo data on first boot.
DATABASE_URL=file:../db/custom.db
# A Vercel preview can omit this and use disposable /tmp storage.

# --- Sessions (required in production) -------------------------------------
# HMAC secret for per-tab session tokens. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Enable only for disposable previews that should auto-create demo accounts.
# ALLOW_DEMO_SEED=true

# Development test helper. Never enable this in a public production project.
# EXPOSE_DEMO_RESET_CODE=true

# --- Price provider (optional: overrides Management settings) --------------
# coingecko (live) | simulated | custom
#PRICE_PROVIDER=coingecko
#PRICE_PROVIDER_URL=
#PRICE_REFRESH_MS=5000
